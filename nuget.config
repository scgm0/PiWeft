<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<packageSources>
		<clear />
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
		<!-- Jint 5 的预览包只发布在官方 Feedz 源；版本固定在 Directory.Packages.props。 -->
		<add key="Jint-preview" value="https://f.feedz.io/sebastienros/jint/nuget/index.json" protocolVersion="3" />
	</packageSources>
	<packageSourceMapping>
		<packageSource key="nuget.org">
			<package pattern="*" />
		</packageSource>
		<packageSource key="Jint-preview">
			<package pattern="Jint" />
		</packageSource>
	</packageSourceMapping>
</configuration>
