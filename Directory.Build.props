<Project>

  <PropertyGroup>
	<Product>PiWeft</Product>
	<TargetFramework>net11.0</TargetFramework>
	<!-- .NET 11 SDK 的 preview 对应 C# 15。 -->
	<LangVersion>preview</LangVersion>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
	<WarningsNotAsErrors>CS1591</WarningsNotAsErrors>
	<GenerateDocumentationFile>false</GenerateDocumentationFile>

	<EnableAotAnalyzer>true</EnableAotAnalyzer>
	<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
	<EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
	<InvariantGlobalization>false</InvariantGlobalization>

	<!-- IL2104/IL3053 表示被引用的程序集自带裁剪/AOT 警告（目前来自 Jint 5 预览包），
	     不是本项目可修的问题。本项目代码的 IL2026/IL2111/IL3050 仍逐条报告，
	     AOT 兼容性由 tools/PiWeft.AotSmoke 发布冒烟验证。 -->
	<NoWarn>$(NoWarn);IL2104;IL3053</NoWarn>

	<!-- 桌面 UI 直接编译 external/MewUI 的上游源码；不再引用 NuGet 版 MewUI。 -->
	<MewUISourceRoot Condition="'$(MewUISourceRoot)' == ''">$(MSBuildThisFileDirectory)external/MewUI/</MewUISourceRoot>
  </PropertyGroup>

  <ItemGroup>
	<!-- Jint 5 的反射式 CLR 投影落在宿主未使用的能力上：codemode 与扩展宿主都经 ClrFunction
	     传 JsValue，FromObject 只用于字符串与标量。关掉这个进程级开关后，运行时不再有
	     ReflectionHostInterop，裁剪器能去掉整条反射链，AOT 产物小约 0.5 MB。
	     开关默认 true；这里显式声明，让测试与 AOT 发布共用同一份配置。见 Jint 5 迁移文档 6.8。 -->
	<RuntimeHostConfigurationOption Include="Jint.Runtime.Interop.ReflectionEnabled" Value="false" Trim="true" />
  </ItemGroup>

</Project>
