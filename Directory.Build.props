<Project>

  <PropertyGroup>
	<Product>PiWeft</Product>
	<TargetFramework>net10.0</TargetFramework>
	<LangVersion>preview</LangVersion>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
	<WarningsNotAsErrors>CS1591</WarningsNotAsErrors>
	<GenerateDocumentationFile>false</GenerateDocumentationFile>

	<EnableAotAnalyzer>true</EnableAotAnalyzer>
	<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
	<EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
	<InvariantGlobalization>false</InvariantGlobalization>

	<!-- IL2104/IL3053 只表示"被引用的程序集自身带有裁剪/AOT 警告"（目前来自 Jint 5 预览包，
	     由其作者负责），不含本项目可修的信息；本项目代码的警告（IL2026/IL2111/IL3050 等）
	     仍会逐条报告。AOT 兼容性由 tools/PiWeft.AotSmoke 发布冒烟兜底。 -->
	<NoWarn>$(NoWarn);IL2104;IL3053</NoWarn>

	<!-- 桌面 UI 直接编译 external/MewUI 的上游源码；不再引用 NuGet 版 MewUI。 -->
	<MewUISourceRoot Condition="'$(MewUISourceRoot)' == ''">$(MSBuildThisFileDirectory)external/MewUI/</MewUISourceRoot>
  </PropertyGroup>

  <ItemGroup>
	<!-- Jint 5 的反射式 CLR 投影只落在本宿主未使用的能力上：codemode 与扩展宿主一律经 ClrFunction
	     传 JsValue，FromObject 只用于字符串与标量。关掉这个进程级开关后，运行时不再有
	     ReflectionHostInterop，裁剪器也能连根去掉整条反射链（AOT 产物小约 0.5 MB；ILC 仍会
	     为 Jint.dll 聚合报告 IL2104/IL3053，那是程序集自带标注，不代表本项目可修）。
	     开关默认 true；这里显式声明，让测试与 AOT 发布共用同一份运行时配置。
	     见 Jint 5 迁移文档 6.8。 -->
	<RuntimeHostConfigurationOption Include="Jint.Runtime.Interop.ReflectionEnabled" Value="false" Trim="true" />
  </ItemGroup>

</Project>
