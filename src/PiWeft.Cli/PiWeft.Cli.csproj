<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<IsAotCompatible>true</IsAotCompatible>
		<PublishAot>true</PublishAot>
		<RootNamespace>PiWeft.Cli</RootNamespace>
		<!-- 项目名与命名空间是 PiWeft.Cli，但构建产物必须是 pi：
		     .NET 用输出文件名作为程序集身份，所以 AssemblyName 只能是 pi。 -->
		<AssemblyName>pi</AssemblyName>
		<AssemblyTitle>PiWeft CLI</AssemblyTitle>
		<InvariantGlobalization>false</InvariantGlobalization>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="PiWeft.Cli.Tests" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Logging" />
		<PackageReference Include="ZLogger" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="../PiWeft.Ai/PiWeft.Ai.csproj" />
		<ProjectReference Include="../PiWeft.Agent/PiWeft.Agent.csproj" />
		<ProjectReference Include="../PiWeft.CodingAgent/PiWeft.CodingAgent.csproj" />
		<ProjectReference Include="../PiWeft.Mcp/PiWeft.Mcp.csproj" />
	</ItemGroup>

</Project>
