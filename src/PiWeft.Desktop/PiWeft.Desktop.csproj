<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<AssemblyName>piweft-desktop</AssemblyName>
		<AssemblyTitle>PiWeft Desktop</AssemblyTitle>
		<RootNamespace>PiWeft.Desktop</RootNamespace>
		<PublishAot>true</PublishAot>
		<TrimMode>full</TrimMode>
		<InvariantGlobalization>false</InvariantGlobalization>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<PropertyGroup>
		<MewUITarget Condition="'$(RuntimeIdentifier)' == '' and $([System.OperatingSystem]::IsWindows())">windows</MewUITarget>
		<MewUITarget Condition="'$(RuntimeIdentifier)' == '' and $([System.OperatingSystem]::IsMacOS())">macos</MewUITarget>
		<MewUITarget Condition="'$(RuntimeIdentifier)' == '' and $([System.OperatingSystem]::IsLinux())">linux</MewUITarget>
		<MewUITarget Condition="$(RuntimeIdentifier.StartsWith('win'))">windows</MewUITarget>
		<MewUITarget Condition="$(RuntimeIdentifier.StartsWith('osx'))">macos</MewUITarget>
		<MewUITarget Condition="$(RuntimeIdentifier.StartsWith('linux'))">linux</MewUITarget>
	</PropertyGroup>

	<PropertyGroup Condition="'$(MewUITarget)' == 'linux'">
		<DefineConstants>$(DefineConstants);MEWUI_X11</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(MewUITarget)' == 'windows'">
		<DefineConstants>$(DefineConstants);MEWUI_WIN32</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(MewUITarget)' == 'macos'">
		<DefineConstants>$(DefineConstants);MEWUI_MACOS</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Aprillz.MewUI.Core" />
		<PackageReference Include="Aprillz.MewUI.Svg" />
		<PackageReference Include="MiniPty" />
	</ItemGroup>

	<ItemGroup Condition="'$(MewUITarget)' == 'linux'">
		<PackageReference Include="Aprillz.MewUI.Platform.X11" />
		<PackageReference Include="Aprillz.MewUI.Backend.MewVG.X11" />
	</ItemGroup>

	<ItemGroup Condition="'$(MewUITarget)' == 'windows'">
		<PackageReference Include="Aprillz.MewUI.Platform.Win32" />
		<PackageReference Include="Aprillz.MewUI.Backend.Direct2D" />
	</ItemGroup>

	<ItemGroup Condition="'$(MewUITarget)' == 'macos'">
		<PackageReference Include="Aprillz.MewUI.Platform.MacOS" />
		<PackageReference Include="Aprillz.MewUI.Backend.MewVG.MacOS" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="PiWeft.Desktop.Tests" />
	</ItemGroup>

	<ItemGroup>
		<!-- 流式期间每帧都要把累积中的回复整份物化成字符串；长回复的单份就超过默认 85 KB 的
		     LOH 门槛，持续落入只随 Gen2 回收的大对象堆（实测 89 MiB / 37.9 MiB 碎片）。
		     把门槛提到 1 MiB：这些字符串改走可压缩的分代堆，Gen0/Gen2 都能便宜地收走。 -->
		<RuntimeHostConfigurationOption Include="System.GC.LOHThreshold" Value="1048576" Trim="false" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources/fonts/*.ttf" />
		<EmbeddedResource Include="Resources/icons/*.svg" />
		<None Include="Resources/fonts/LICENSE-*.txt" />
		<None Include="Resources/icons/LICENSE-*.txt" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="../PiWeft.Markdown/PiWeft.Markdown.csproj" />
		<ProjectReference Include="../PiWeft.CodingAgent/PiWeft.CodingAgent.csproj" />
		<ProjectReference Include="../PiWeft.Mcp/PiWeft.Mcp.csproj" />
		<ProjectReference Include="../PiWeft.Cli/PiWeft.Cli.csproj" />
	</ItemGroup>

</Project>
