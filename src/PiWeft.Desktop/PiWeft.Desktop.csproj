<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<AssemblyName>piweft-desktop</AssemblyName>
		<AssemblyTitle>PiWeft Desktop</AssemblyTitle>
		<RootNamespace>PiWeft.Desktop</RootNamespace>
		<PublishAot>true</PublishAot>
		<TrimMode>full</TrimMode>
		<InvariantGlobalization>false</InvariantGlobalization>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<PropertyGroup>
		<MewUITarget Condition="'$(RuntimeIdentifier)' == '' and $([System.OperatingSystem]::IsWindows())">windows</MewUITarget>
		<MewUITarget Condition="'$(RuntimeIdentifier)' == '' and $([System.OperatingSystem]::IsMacOS())">macos</MewUITarget>
		<MewUITarget Condition="'$(RuntimeIdentifier)' == '' and $([System.OperatingSystem]::IsLinux())">linux</MewUITarget>
		<MewUITarget Condition="$(RuntimeIdentifier.StartsWith('win'))">windows</MewUITarget>
		<MewUITarget Condition="$(RuntimeIdentifier.StartsWith('osx'))">macos</MewUITarget>
		<MewUITarget Condition="$(RuntimeIdentifier.StartsWith('linux'))">linux</MewUITarget>
	</PropertyGroup>

	<PropertyGroup Condition="'$(MewUITarget)' == 'linux'">
		<DefineConstants>$(DefineConstants);MEWUI_X11</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(MewUITarget)' == 'windows'">
		<DefineConstants>$(DefineConstants);MEWUI_WIN32</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(MewUITarget)' == 'macos'">
		<DefineConstants>$(DefineConstants);MEWUI_MACOS</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="$(MewUISourceRoot)src/MewUI/MewUI.csproj" GlobalPropertiesToRemove="PublishAot" />
		<ProjectReference Include="$(MewUISourceRoot)extensions/MewUI.Svg/MewUI.Svg.csproj" GlobalPropertiesToRemove="PublishAot" />
		<PackageReference Include="MiniPty" />
		<PackageReference Include="OldBit.Beep" />
	</ItemGroup>

	<ItemGroup Condition="'$(MewUITarget)' == 'linux'">
		<ProjectReference Include="$(MewUISourceRoot)src/MewUI.Platform.X11/MewUI.Platform.X11.csproj" GlobalPropertiesToRemove="PublishAot" />
		<ProjectReference Include="$(MewUISourceRoot)src/MewUI.Backend.MewVG.X11/MewUI.Backend.MewVG.X11.csproj" GlobalPropertiesToRemove="PublishAot" />
	</ItemGroup>

	<ItemGroup Condition="'$(MewUITarget)' == 'windows'">
		<ProjectReference Include="$(MewUISourceRoot)src/MewUI.Platform.Win32/MewUI.Platform.Win32.csproj" GlobalPropertiesToRemove="PublishAot" />
		<ProjectReference Include="$(MewUISourceRoot)src/MewUI.Backend.Direct2D/MewUI.Backend.Direct2D.csproj" GlobalPropertiesToRemove="PublishAot" />
	</ItemGroup>

	<ItemGroup Condition="'$(MewUITarget)' == 'macos'">
		<ProjectReference Include="$(MewUISourceRoot)src/MewUI.Platform.MacOS/MewUI.Platform.MacOS.csproj" GlobalPropertiesToRemove="PublishAot" />
		<ProjectReference Include="$(MewUISourceRoot)src/MewUI.Backend.MewVG.MacOS/MewUI.Backend.MewVG.MacOS.csproj" GlobalPropertiesToRemove="PublishAot" />
	</ItemGroup>

	<!-- MewUI.Svg 只在非 AOT 构建中引用源生成器；publish 时 GlobalPropertiesToRemove 去掉了 PublishAot，restore 图却按 AOT 排除了它。首次构建前单独还原，避免 NETSDK1004。 -->
	<Target Name="RestoreMewUISvgGenerator" BeforeTargets="ResolveProjectReferences"
		Condition="'$(PublishAot)' == 'true' and Exists('$(MewUISourceRoot)extensions/MewUI.Svg/ThirdParty/SvgNet/Generators/Svg.Generators.csproj') and !Exists('$(MewUISourceRoot)extensions/MewUI.Svg/ThirdParty/SvgNet/Generators/obj/project.assets.json')">
		<MSBuild Projects="$(MewUISourceRoot)extensions/MewUI.Svg/ThirdParty/SvgNet/Generators/Svg.Generators.csproj"
			Targets="Restore" Properties="Configuration=$(Configuration)" RemoveProperties="PublishAot" />
	</Target>

	<Target Name="ValidateLocalMewUISource" BeforeTargets="PrepareForBuild"
		Condition="!Exists('$(MewUISourceRoot)src/MewUI/MewUI.csproj')">
		<Error Text="MewUI source is missing at $(MewUISourceRoot). Run git submodule update --init --recursive (or scripts/mewui-source.sh / .ps1) first." />
	</Target>

	<ItemGroup>
		<InternalsVisibleTo Include="PiWeft.Desktop.Tests" />
	</ItemGroup>

	<ItemGroup>
		<!-- 流式期间每帧都要把累积中的回复整份物化成字符串；长回复的单份就超过默认 85 KB 的
		     LOH 门槛，持续落入只随 Gen2 回收的大对象堆（实测 89 MiB / 37.9 MiB 碎片）。
		     把门槛提到 1 MiB：这些字符串改走可压缩的分代堆，Gen0/Gen2 都能便宜地收走。 -->
		<RuntimeHostConfigurationOption Include="System.GC.LOHThreshold" Value="1048576" Trim="false" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources/fonts/*.ttf" />
		<EmbeddedResource Include="Resources/icons/*.svg" />
		<!-- 提示音：与 PiDeck 同一套纯合成 WAV（见 Resources/sounds/README.md）。 -->
		<EmbeddedResource Include="Resources/sounds/*.wav" />
		<None Include="Resources/fonts/LICENSE-*.txt" />
		<None Include="Resources/icons/LICENSE-*.txt" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="../PiWeft.Markdown/PiWeft.Markdown.csproj" />
		<ProjectReference Include="../PiWeft.CodingAgent/PiWeft.CodingAgent.csproj" />
		<ProjectReference Include="../PiWeft.Mcp/PiWeft.Mcp.csproj" />
		<ProjectReference Include="../PiWeft.Cli/PiWeft.Cli.csproj" />
	</ItemGroup>

</Project>
